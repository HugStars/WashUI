{
    "name": "cyan_ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "vite",
        "build": "vite build",
        "build:ui": "vite build --mode ui",
        "preview": "vite preview",
        "serve:docs": "vitepress dev ./docs --open",
        "build:docs": "vitepress build ./docs",
        "preview:docs": "vitepress preview ./docs",
        "serve_both": "concurrently \"vite\" \"vitepress dev ./docs\""
    },
    "dependencies": {
        "sass-embedded": "^1.77.8",
        "vue": "^3.4.29",
        "vue-router": "^4.3.3"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.5",
        "concurrently": "^8.2.2",
        "vite": "^5.3.1",
        "vitepress": "^1.3.2"
    }
}
