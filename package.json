{
    "name": "wash-ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HugStars/WashUI.git"
    },
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "dev": "pnpm dev:docs",
        "dev:docs": "vite",
        "dev:docs:force": "vite --force",
        "build": "pnpm build:docs",
        "build:docs": "vite build",
        "build:ui": "pnpm --filter @wash/ui build",
        "preview": "pnpm preview:docs",
        "preview:docs": "vite preview"
    },
    "dependencies": {
        "@wash/ui": "workspace:*",
        "vue": "^3.5.28",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "vite": "^7.3.1"
    },
    "engines": {
        "node": ">=20.19"
    }
}
