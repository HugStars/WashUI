{
    "name": "washui-monorepo",
    "version": "0.1.0",
    "private": true,
    "author": {
        "name": "HugStars",
        "email": "super@hugstars.top"
    },
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HugStars/WashUI.git"
    },
    "packageManager": "pnpm@12.18.0",
    "scripts": {
        "dev": "vite",
        "dev:docs": "vite",
        "dev:docs:force": "vite --force",
        "build": "vite build",
        "build:docs": "vite build",
        "build:ui": "pnpm --filter wash-ui build",
        "build:types": "pnpm --filter wash-ui build:types",
        "publish:ui": "pnpm --filter wash-ui publish",
        "test": "vitest run",
        "test:watch": "vitest",
        "preview": "vite preview",
        "preview:docs": "vite preview"
    },
    "dependencies": {
        "wash-ui": "workspace:*",
        "vue": "^3.5.28",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/compiler-sfc": "^3.5.45",
        "@vue/test-utils": "^2.5.1",
        "acorn": "^8.19.0",
        "jsdom": "^31.0.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "engines": {
        "node": ">=20.19"
    }
}