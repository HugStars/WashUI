{
    "name": "@wash/ui",
    "version": "0.1.0",
    "description": "WashUI 前端设计系统：设计变量、Vue 组件、布局、Toast、路由与工具",
    "license": "UNLICENSED",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HugStars/WashUI.git"
    },
    "sideEffects": [
