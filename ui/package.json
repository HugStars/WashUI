        "vue-router": "^4.4.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "vue-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "vite": "^7.3.1",
        "vue": "^3.5.28"
    },
    "publishConfig": {
