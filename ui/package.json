{
    "name": "wash-ui",
    "version": "0.1.0",
    "description": "WashUI 前端设计系统：设计变量、Vue 组件、布局、Toast、路由与工具",
    "license": "MIT",
    "author": {
        "name": "HugStars",
        "email": "super@hugstars.top"
    },
    "type": "module",
    "keywords": [
        "vue",
        "vue3",
        "ui",
        "design-system",
        "components",
        "vite"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HugStars/WashUI.git",
        "directory": "ui"
    },
    "homepage": "https://github.com/HugStars/WashUI#readme",
    "bugs": {
        "url": "https://github.com/HugStars/WashUI/issues"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "types",
        "tokens.css",
        "tokens.js",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./types/index.d.ts",
    "style": "./dist/style.css",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./style.css": "./dist/style.css",
        "./utils": {
            "types": "./types/utils/index.d.ts",
            "default": "./dist/utils.js"
        },
        "./router": {
            "types": "./types/router/index.d.ts",
            "default": "./dist/router.js"
        },
        "./components/*": {
            "types": "./types/components/*.d.ts",
            "default": "./dist/components/*.js"
        },
        "./layout/*": {
            "types": "./types/layout/*.d.ts",
            "default": "./dist/layout/*.js"
        },
        "./tokens.css": "./tokens.css",
        "./tokens.js": "./tokens.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build && pnpm build:types",
        "build:types": "vue-tsc -p ../tsconfig.types.json && node ../scripts/build-types.mjs",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "vue": "^3.5.0",
        "vue-router": "^4.4.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "vue-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "vite": "^7.3.1",
        "vue": "^3.5.28"
    },
    "engines": {
        "node": ">=20.19"
    },
    "dependencies": {
        "@speed-highlight/core": "^2.1.0",
        "morphicons": "^2.0.2"
    }
}
