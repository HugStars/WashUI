{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "ui/types",
        "rootDir": "ui/src",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "skipLibCheck": true,
        "noEmitOnError": false,
        "types": []
    },
    "include": ["ui/src/**/*.js", "ui/src/**/*.vue", "ui/src/**/*.d.ts"],
    "exclude": ["ui/src/**/*.test.js"]
}
